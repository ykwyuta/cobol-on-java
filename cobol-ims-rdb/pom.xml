<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.cobolonjava</groupId>
    <artifactId>cobol-on-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>cobol-ims-rdb</artifactId>
  <name>cobol-ims-rdb</name>
  <description>IMS のデータベースを RDB の表に生バイトで置く JDBC の置き場 (設計 78 §3.2、ADR-0013)</description>

  <dependencies>
    <!-- 設計 78 §2.2: JDBC 標準 (java.sql) だけに依存し、方言は SQL の文で吸収する -->
    <dependency>
      <groupId>dev.cobolonjava</groupId>
      <artifactId>cobol-ims</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 実 PostgreSQL を使う試験だけが使う。POSTGRES_IT_ENABLED が無ければ流れない -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 実 Db2 を使う試験だけが使う。DB2_IT_ENABLED が無ければ流れない -->
    <dependency>
      <groupId>com.ibm.db2</groupId>
      <artifactId>jcc</artifactId>
      <version>${db2-jcc.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
