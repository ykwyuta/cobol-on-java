<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.cobolonjava</groupId>
    <artifactId>cobol-on-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>cobol-mq</artifactId>
  <name>cobol-mq</name>
  <description>IBM MQ の MQI (MQOPEN / MQPUT / MQGET ...) を region の中の待ち行列で動かす (設計 88)</description>

  <dependencies>
    <!-- 設計 88 §3: cobol-runtime だけに依存する。JMS や MQ の製品のクライアントを持ち込まない -->
    <dependency>
      <groupId>dev.cobolonjava</groupId>
      <artifactId>cobol-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <!-- 翻訳した COBOL から CALL 'MQPUT' などを呼ぶ試験だけが使う -->
      <groupId>dev.cobolonjava</groupId>
      <artifactId>cobol-compiler</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
