GRTSET   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      *
               TIOAPFX=YES,EXTATT=YES,CTRL=FREEKB
GRTMAP   DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=30,ATTRB=(PROT,BRT),COLOR=TURQUOISE,  *
               INITIAL='GREETING -- COBOL ON JAVA'
         DFHMDF POS=(1,60),LENGTH=9,INITIAL='TERMINAL:',ATTRB=ASKIP
TERM     DFHMDF POS=(1,70),LENGTH=4,ATTRB=(PROT,BRT),COLOR=YELLOW
         DFHMDF POS=(3,1),LENGTH=11,INITIAL='YOUR NAME:',ATTRB=ASKIP
NAME     DFHMDF POS=(3,13),LENGTH=10,ATTRB=(UNPROT,NORM,IC),           *
               HILIGHT=UNDERLINE,COLOR=GREEN
         DFHMDF POS=(3,24),LENGTH=1,ATTRB=ASKIP
MSG      DFHMDF POS=(5,1),LENGTH=40,ATTRB=(PROT,BRT),COLOR=NEUTRAL
         DFHMDF POS=(7,1),LENGTH=6,INITIAL='TASKS:',ATTRB=ASKIP
CNT      DFHMDF POS=(7,8),LENGTH=4,ATTRB=(PROT,NORM)
         DFHMDF POS=(24,1),LENGTH=40,ATTRB=ASKIP,COLOR=BLUE,           *
               INITIAL='ENTER=GREET  CLEAR=REDISPLAY  PF3=END'
         DFHMSD TYPE=FINAL
         END
