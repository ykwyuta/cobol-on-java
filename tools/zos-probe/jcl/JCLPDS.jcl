//JCLPDS   JOB (ACCT),'ZOS PROBE',CLASS=A,MSGCLASS=X,REGION=0M
//JOBLIB   DD DISP=SHR,DSN=YOURID.PROBE.LOAD
//*--------------------------------------------------------------------
//* JCLPDS - a full PDS directory and a missing member (P-061, P-057,
//* P-059)
//* The PDS has one directory block (256 bytes). IEBGENER adds members
//* M01..M25, one per step. Q: at which member does it stop, with which
//* completion code (SB14-0C?) or message and return code? Then
//* LISTDS MEMBERS, and CBLOPT / CBLOPTN on a member that does not
//* exist (OPEN status 05 / 35, or S013-18?).
//*--------------------------------------------------------------------
//CLEAN    EXEC PGM=IEFBR14
//PDS1     DD DSN=YOURID.PROBE.PDS1,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1,1))
//ALLOC    EXEC PGM=IEFBR14
//PDS1     DD DSN=YOURID.PROBE.PDS1,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5,1))
//G01      EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD *
MEMBER M01
/*
//SYSUT2   DD DSN=YOURID.PROBE.PDS1(M01),DISP=SHR
//G02      EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD *
