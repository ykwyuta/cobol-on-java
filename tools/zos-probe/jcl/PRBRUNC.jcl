//PRBRUNC  JOB (ACCT),'ZOS PROBE',CLASS=A,MSGCLASS=X,REGION=0M
//JOBLIB   DD DISP=SHR,DSN=YOURID.PROBE.LOAD
//*--------------------------------------------------------------------
//* PRBRUNC - run the COBOL language probes. Each step writes PRB
//* lines to its SYSOUT; files go to YOURID.PROBE.OUT.*. Download the
//* whole job output and the OUT datasets (see the runbook).
//* A step whose load module is missing (the compile failed) ends
//* with S806; that is expected for CBLNUMM, CBLBIN31 and perhaps
//* CBLC72A / CBLC72B. COND=EVEN keeps the later steps running.
//*--------------------------------------------------------------------
//CLEAN    EXEC PGM=IEFBR14
//SYNCF    DD DSN=YOURID.PROBE.OUT.SYNCF,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1))
//PRTF     DD DSN=YOURID.PROBE.OUT.PRTF,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1))
//LINF     DD DSN=YOURID.PROBE.OUT.LINF,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1))
//PRTFN    DD DSN=YOURID.PROBE.OUT.PRTFN,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1))
//LINFN    DD DSN=YOURID.PROBE.OUT.LINFN,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1))
//PRTC     DD DSN=YOURID.PROBE.OUT.PRTC,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1))
//NUMN     EXEC PGM=CBLNUM,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//NUMP     EXEC PGM=CBLNUMP,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//NUMM     EXEC PGM=CBLNUMM,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//EDIT     EXEC PGM=CBLEDIT,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//WSI1     EXEC PGM=CBLWSINI,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//WSI2     EXEC PGM=CBLWSINI,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//CEEOPTS  DD *
STORAGE(FE,DE,BE)
/*
//WSI3     EXEC PGM=CBLWSINN,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//WSI4     EXEC PGM=CBLWSINN,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//CEEOPTS  DD *
STORAGE(FE,DE,BE)
/*
//SYNC     EXEC PGM=CBLSYNC,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//SYNCF    DD DSN=YOURID.PROBE.OUT.SYNCF,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5))
//ACPT     EXEC PGM=CBLACPT,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//SYSIN    DD *
12345
 
/*
//INSP     EXEC PGM=CBLINSP,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//PRNT     EXEC PGM=CBLPRNT,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//PRTF     DD DSN=YOURID.PROBE.OUT.PRTF,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5))
//LINF     DD DSN=YOURID.PROBE.OUT.LINF,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5))
//PRNTN    EXEC PGM=CBLPRNTN,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//PRTF     DD DSN=YOURID.PROBE.OUT.PRTFN,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5))
//LINF     DD DSN=YOURID.PROBE.OUT.LINFN,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5))
//PRNC     EXEC PGM=CBLPRNC,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//PRTC     DD DSN=YOURID.PROBE.OUT.PRTC,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5))
//C72A     EXEC PGM=CBLC72A,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//C72B     EXEC PGM=CBLC72B,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//C72C     EXEC PGM=CBLC72C,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//DBG1     EXEC PGM=CBLDEBUG,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//DBG2     EXEC PGM=CBLDEBUG,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//CEEOPTS  DD *
DEBUG
/*
//DBG3     EXEC PGM=CBLDBGN,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//DBG4     EXEC PGM=CBLDBGN,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//CEEOPTS  DD *
DEBUG
/*
//FUNC     EXEC PGM=CBLFUNC,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//FUNE     EXEC PGM=CBLFUNE,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//FUNX     EXEC PGM=CBLFUNX,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//BIN31    EXEC PGM=CBLBIN31,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//FLT      EXEC PGM=CBLFLT,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//PARM1    EXEC PGM=CBLPARM,PARM='SHORT',COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//PARM2    EXEC PGM=CBLPARM,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
