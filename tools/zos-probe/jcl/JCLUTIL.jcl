//JCLUTIL  JOB (ACCT),'ZOS PROBE',CLASS=A,MSGCLASS=X,REGION=0M
//JOBLIB   DD DISP=SHR,DSN=YOURID.PROBE.LOAD
//*--------------------------------------------------------------------
//* JCLUTIL - utility outputs (P-047): DFSORT with SUM and OUTFIL
//* reports, ICETOOL, IEBGENER, IDCAMS REPRO. The data results are
//* compared byte for byte; the SYSOUT / TOOLMSG / SYSPRINT texts
//* (message ids, report layout, page headers) are recorded as they
//* are, to decide how far this implementation copies them.
//*--------------------------------------------------------------------
//CLEAN    EXEC PGM=IEFBR14
//UTSORTED DD DSN=YOURID.PROBE.UT.SORTED,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1))
//UTREPRO  DD DSN=YOURID.PROBE.UT.REPRO,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1))
//SORT     EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD *
BBB 0010 X
AAA 0005 Y
CCC 0001 Z
AAA 0007 Y
BBB 0020 X
AAA 0003 W
/*
//SORTOUT  DD DSN=YOURID.PROBE.UT.SORTED,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1))
//RPT      DD SYSOUT=*
//SYSIN    DD *
  SORT FIELDS=(1,3,CH,A)
  SUM FIELDS=(5,4,ZD)
  OUTFIL FNAMES=RPT,HEADER1=('PROBE REPORT'),
    OUTREC=(1,3,2X,5,4,ZD,EDIT=(IIT)),
    TRAILER1=('COUNT=',COUNT=(M10,LENGTH=4))
/*
//TOOL     EXEC PGM=ICETOOL,COND=EVEN
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//IN       DD DSN=YOURID.PROBE.UT.SORTED,DISP=SHR
//LIST1    DD SYSOUT=*
//TOOLIN   DD *
  COUNT FROM(IN)
  DISPLAY FROM(IN) LIST(LIST1) ON(1,3,CH) ON(5,4,ZD)
  STATS FROM(IN) ON(5,4,ZD)
/*
//GENER    EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  GENERATE MAXFLDS=2
  RECORD FIELD=(3,1,,1),FIELD=(4,5,,4)
/*
//SYSUT1   DD DSN=YOURID.PROBE.UT.SORTED,DISP=SHR
//SYSUT2   DD SYSOUT=*
//REPRO    EXEC PGM=IDCAMS,COND=EVEN
//SYSPRINT DD SYSOUT=*
//IN       DD DSN=YOURID.PROBE.UT.SORTED,DISP=SHR
//OUT      DD DSN=YOURID.PROBE.UT.REPRO,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1))
//SYSIN    DD *
  REPRO INFILE(IN) OUTFILE(OUT)
/*
//DUMP     EXEC PGM=CBLDUMP,COND=EVEN
//INF      DD DSN=YOURID.PROBE.UT.REPRO,DISP=SHR
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
REPRO
/*
