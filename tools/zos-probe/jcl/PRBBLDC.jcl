//PRBBLDC  JOB (ACCT),'ZOS PROBE',CLASS=A,MSGCLASS=X,REGION=0M
//*--------------------------------------------------------------------
//* PRBBLDC - compile and bind the COBOL probes, with the option
//* variants that the scenarios ask for. Keep the job output: the
//* compile listings are observations (MAP for CBLSYNC, messages for
//* CBLBIN31 / CBLC72A / CBLC72B / CBLNUMM, line numbers for CBLDEBUG).
//* A variant that does not compile is itself a result; later steps
//* still run.
//* Site values: the compiler and LE library names below.
//*--------------------------------------------------------------------
//         SET COBLIB=IGY.V6R4M0.SIGYCOMP
//         SET LELKED=CEE.SCEELKED
//CBL      PROC MEM=,LMOD=
//COMPILE  EXEC PGM=IGYCRCTL,PARM='MAP'
//STEPLIB  DD DISP=SHR,DSN=&COBLIB
//SYSIN    DD DISP=SHR,DSN=YOURID.PROBE.SRC.COBOL(&MEM)
//SYSLIB   DD DISP=SHR,DSN=YOURID.PROBE.SRC.COPY
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DISP=SHR,DSN=YOURID.PROBE.OBJ(&LMOD)
//SYSUT1   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT2   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT3   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT4   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT5   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT6   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT7   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT8   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT9   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT10  DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT11  DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT12  DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT13  DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT14  DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT15  DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSMDECK DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//BIND     EXEC PGM=IEWBLINK,COND=(8,LT,COMPILE),
//            PARM='LIST,MAP,XREF,RENT'
//SYSLIB   DD DISP=SHR,DSN=&LELKED
//SYSLIN   DD DISP=SHR,DSN=YOURID.PROBE.OBJ(&LMOD)
//SYSLMOD  DD DISP=SHR,DSN=YOURID.PROBE.LOAD(&LMOD)
//SYSPRINT DD SYSOUT=*
//         PEND
//*
//* Probes with the default options (NUMPROC(NOPFD), ARITH(COMPAT),
//* ADV, NONUMBER, NOSSRANGE on most installations: check the
//* options list at the top of each listing and write it down).
//CBLNUM   EXEC CBL,MEM=CBLNUM,LMOD=CBLNUM,
//            PARM.COMPILE='MAP'
//CBLEDIT  EXEC CBL,MEM=CBLEDIT,LMOD=CBLEDIT,
//            PARM.COMPILE='MAP'
//CBLWSINI EXEC CBL,MEM=CBLWSINI,LMOD=CBLWSINI,
//            PARM.COMPILE='MAP'
//CBLSYNC  EXEC CBL,MEM=CBLSYNC,LMOD=CBLSYNC,
//            PARM.COMPILE='MAP'
//CBLACPT  EXEC CBL,MEM=CBLACPT,LMOD=CBLACPT,
//            PARM.COMPILE='MAP'
//CBLINSP  EXEC CBL,MEM=CBLINSP,LMOD=CBLINSP,
//            PARM.COMPILE='MAP'
//CBLPRNT  EXEC CBL,MEM=CBLPRNT,LMOD=CBLPRNT,
//            PARM.COMPILE='MAP'
//CBLPRNC  EXEC CBL,MEM=CBLPRNC,LMOD=CBLPRNC,
//            PARM.COMPILE='MAP'
//CBLC72A  EXEC CBL,MEM=CBLC72A,LMOD=CBLC72A,
//            PARM.COMPILE='MAP'
//CBLC72B  EXEC CBL,MEM=CBLC72B,LMOD=CBLC72B,
//            PARM.COMPILE='MAP'
//CBLC72C  EXEC CBL,MEM=CBLC72C,LMOD=CBLC72C,
//            PARM.COMPILE='MAP'
//CBLDEBUG EXEC CBL,MEM=CBLDEBUG,LMOD=CBLDEBUG,
//            PARM.COMPILE='MAP'
//CBLFUNC  EXEC CBL,MEM=CBLFUNC,LMOD=CBLFUNC,
//            PARM.COMPILE='MAP'
//CBLFLT   EXEC CBL,MEM=CBLFLT,LMOD=CBLFLT,
//            PARM.COMPILE='MAP'
//CBLCP    EXEC CBL,MEM=CBLCP,LMOD=CBLCP,
//            PARM.COMPILE='MAP'
//CBLABND  EXEC CBL,MEM=CBLABND,LMOD=CBLABND,
//            PARM.COMPILE='MAP'
//CBLRC    EXEC CBL,MEM=CBLRC,LMOD=CBLRC,
//            PARM.COMPILE='MAP'
//CBLGEN   EXEC CBL,MEM=CBLGEN,LMOD=CBLGEN,
//            PARM.COMPILE='MAP'
//CBLDUMP  EXEC CBL,MEM=CBLDUMP,LMOD=CBLDUMP,
//            PARM.COMPILE='MAP'
//CBLOPT   EXEC CBL,MEM=CBLOPT,LMOD=CBLOPT,
//            PARM.COMPILE='MAP'
//CBLOPTN  EXEC CBL,MEM=CBLOPTN,LMOD=CBLOPTN,
//            PARM.COMPILE='MAP'
//CBLASMD  EXEC CBL,MEM=CBLASMD,LMOD=CBLASMD,
//            PARM.COMPILE='MAP'
//CBLPARM  EXEC CBL,MEM=CBLPARM,LMOD=CBLPARM,
//            PARM.COMPILE='MAP'
//*
//* Variants: the same source under another load module name.
//NUMP     EXEC CBL,MEM=CBLNUM,LMOD=CBLNUMP,
//            PARM.COMPILE='MAP,NUMPROC(PFD)'
//NUMM     EXEC CBL,MEM=CBLNUM,LMOD=CBLNUMM,
//            PARM.COMPILE='MAP,NUMPROC(MIG)'
//WSIN     EXEC CBL,MEM=CBLWSINI,LMOD=CBLWSINN,
//            PARM.COMPILE='MAP,NORENT'
//PRNTN    EXEC CBL,MEM=CBLPRNT,LMOD=CBLPRNTN,
//            PARM.COMPILE='MAP,NOADV'
//DBGN     EXEC CBL,MEM=CBLDEBUG,LMOD=CBLDBGN,
//            PARM.COMPILE='MAP,NUMBER'
//FUNE     EXEC CBL,MEM=CBLFUNC,LMOD=CBLFUNE,
//            PARM.COMPILE='MAP,ARITH(EXTEND)'
//FUNX     EXEC CBL,MEM=CBLFUNX,LMOD=CBLFUNX,
//            PARM.COMPILE='MAP,ARITH(EXTEND)'
//BIN31    EXEC CBL,MEM=CBLBIN31,LMOD=CBLBIN31,
//            PARM.COMPILE='MAP,ARITH(EXTEND)'
//ABNP     EXEC CBL,MEM=CBLABND,LMOD=CBLABNP,
//            PARM.COMPILE='MAP,NUMPROC(PFD)'
//ABNS     EXEC CBL,MEM=CBLABND,LMOD=CBLABNS,
//            PARM.COMPILE='MAP,SSRANGE'
