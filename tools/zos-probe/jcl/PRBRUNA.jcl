//PRBRUNA  JOB (ACCT),'ZOS PROBE',CLASS=A,MSGCLASS=X,REGION=0M
//JOBLIB   DD DISP=SHR,DSN=YOURID.PROBE.LOAD
//*--------------------------------------------------------------------
//* PRBRUNA - run the HLASM probes through the COBOL driver CBLASMD.
//* One function code per step: codes 07, 08, 09 and 21 may abend
//* (S0C8 / S0CA), which is the observation for P-174.
//*--------------------------------------------------------------------
//E01      EXEC PGM=CBLASMD,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//SYSIN    DD *
ASMEXE,01
/*
//E02      EXEC PGM=CBLASMD,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//SYSIN    DD *
ASMEXE,02
/*
