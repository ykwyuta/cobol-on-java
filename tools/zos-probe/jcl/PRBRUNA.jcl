//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//SYSIN    DD *
ASMEXE,07
/*
//E08      EXEC PGM=CBLASMD,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//SYSIN    DD *
ASMEXE,08
/*
//E09      EXEC PGM=CBLASMD,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//SYSIN    DD *
ASMEXE,09
/*
//E10      EXEC PGM=CBLASMD,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//SYSIN    DD *
ASMEXE,10
/*
//E11      EXEC PGM=CBLASMD,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//SYSIN    DD *
ASMEXE,11
/*
//PM20     EXEC PGM=CBLASMD,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//SYSIN    DD *
ASMPM,20
/*
//PM21     EXEC PGM=CBLASMD,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//SYSIN    DD *
ASMPM,21
/*
//DC1      EXEC PGM=CBLASMD,COND=EVEN
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//SYSIN    DD *
ASMDC1,30
/*
//DC2      EXEC PGM=CBLASMD,COND=EVEN
//SYSOUT   DD SYSOUT=*
