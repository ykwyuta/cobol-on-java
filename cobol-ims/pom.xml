<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.cobolonjava</groupId>
    <artifactId>cobol-on-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>cobol-ims</artifactId>
  <name>cobol-ims</name>
  <description>IMS の DBD / PSB と DL/I 呼び出しのフレームワーク非依存モデル (設計 78)</description>

  <dependencies>
    <!-- 設計 78 §2.2: cobol-runtime だけに依存する。JDBC / JMS / Spring の型を持ち込まない -->
    <dependency>
      <groupId>dev.cobolonjava</groupId>
      <artifactId>cobol-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <!-- 翻訳した COBOL から CALL 'CBLTDLI' を呼ぶ試験だけが使う -->
      <groupId>dev.cobolonjava</groupId>
      <artifactId>cobol-compiler</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
